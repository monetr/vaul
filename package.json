{
  "name": "@monetr/vaul",
  "version": "1.1.2",
  "description": "Drawer component for React.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "pnpm type-check && rslib build",
    "clean": "rm -rf node_modules dist test-results playwright-report test/.next test/out test/tsconfig.tsbuildinfo",
    "dev": "rslib build --watch",
    "dev:test": "pnpm -r --parallel run dev",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "playwright test"
  },
  "keywords": [
    "react",
    "drawer",
    "dialog",
    "modal"
  ],
  "author": "Emil Kowalski <e@emilkowal.ski>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/monetr/vaul.git"
  },
  "bugs": {
    "url": "https://github.com/monetr/vaul/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@playwright/test": "1.37.1",
    "@radix-ui/react-dialog": "1.0.4",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rslib/core": "^0.21.3",
    "@types/node": "20.5.7",
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.18",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "5.2.2"
  },
  "peerDependencies": {
    "react": "^18.0 || ^19.0.0 || ^19.0.0-rc",
    "react-dom": "^18.0 || ^19.0.0 || ^19.0.0-rc"
  },
  "packageManager": "pnpm@8.8.0",
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.1"
  }
}
