{
  "name": "@monetr/vaul",
  "version": "1.2.6",
  "description": "Drawer component for React.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "pnpm type-check && rslib build",
    "build:analyze": "RSDOCTOR=true pnpm build",
    "clean": "rm -rf node_modules dist",
    "dev": "rslib build --watch",
    "dev:demo": "rsbuild dev",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "rstest run",
    "test:firefox": "rstest run --browser.name firefox",
    "test:webkit": "rstest run --browser.name webkit"
  },
  "keywords": [
    "react",
    "drawer",
    "dialog",
    "modal"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "author": "Emil Kowalski <e@emilkowal.ski>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/monetr/vaul.git"
  },
  "bugs": {
    "url": "https://github.com/monetr/vaul/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@radix-ui/react-dialog": "1.3.1",
    "@rsbuild/core": "2.3.1",
    "@rsbuild/plugin-react": "2.1.1",
    "@rsdoctor/rspack-plugin": "1.6.5",
    "@rslib/core": "1.0.5",
    "@rspress/core": "2.0.19",
    "@rstest/adapter-rslib": "0.12.6",
    "@rstest/browser": "0.12.6",
    "@rstest/browser-react": "0.12.6",
    "@rstest/core": "0.12.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "pnpm@12.17.0"
}
