{
  "name": "@monetr/vaul",
  "version": "1.2.5",
  "description": "Drawer component for React.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "pnpm type-check && rslib build",
    "build:analyze": "RSDOCTOR=true pnpm build",
    "clean": "rm -rf node_modules dist",
    "dev": "rslib build --watch",
    "dev:demo": "rsbuild dev",
    "docs:dev": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "rstest run",
    "test:firefox": "rstest run --browser.name firefox",
    "test:webkit": "rstest run --browser.name webkit"
  },
  "keywords": [
    "react",
    "drawer",
    "dialog",
    "modal"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "author": "Emil Kowalski <e@emilkowal.ski>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/monetr/vaul.git"
  },
  "bugs": {
    "url": "https://github.com/monetr/vaul/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@rsbuild/core": "2.0.8",
    "@rsbuild/plugin-react": "2.0.0",
    "@rsdoctor/rspack-plugin": "1.5.12",
    "@rslib/core": "0.21.5",
    "@rspress/core": "2.0.12",
    "@rstest/adapter-rslib": "0.10.2",
    "@rstest/browser": "0.10.2",
    "@rstest/browser-react": "0.10.2",
    "@rstest/core": "0.10.2",
    "@types/node": "24.12.4",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "playwright": "1.60.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.0.0",
    "react": "^18.0 || ^19.0.0 || ^19.0.0-rc",
    "react-dom": "^18.0 || ^19.0.0 || ^19.0.0-rc"
  },
  "packageManager": "pnpm@10.34.1"
}
